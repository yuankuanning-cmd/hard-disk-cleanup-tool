<UserControl x:Class="ChatGPTCleanupTool.Controls.MediaCenter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Normal">
 <UserControl.Resources>
  <Style x:Key="MediaSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style x:Key="MediaPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Padding" Value="14,5"/><Setter Property="MinHeight" Value="32"/></Style>
 </UserControl.Resources>
 <Grid Margin="16,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="205"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="分析目录" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <TextBox x:Name="RootBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" ToolTip="沿用页面下方的扫描范围白名单；参考目录也会参与只读比较"/>
   <Button Grid.Column="2" Margin="8,0" Content="选择目录" Style="{StaticResource MediaSecondaryButton}" Click="Browse_Click"/>
   <Button Grid.Column="3" Content="分析相似媒体" Style="{StaticResource MediaPrimaryButton}" Click="Scan_Click"/>
  </Grid>
  <WrapPanel Grid.Row="1" Margin="0,10,0,8" VerticalAlignment="Center">
   <CheckBox x:Name="ImageBox" Content="图片" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
   <CheckBox x:Name="VideoBox" Content="视频（五个时间点）" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
   <CheckBox x:Name="AudioBox" Content="声音指纹（前 120 秒）" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center"/>
   <TextBlock Text="图片匹配：" VerticalAlignment="Center"/>
   <ComboBox x:Name="SensitivityBox" Width="125" SelectedIndex="1"><ComboBoxItem Content="严格"/><ComboBoxItem Content="标准"/><ComboBoxItem Content="宽松（多复核）"/></ComboBox>
   <TextBlock Margin="16,0,0,0" Text="只读分析 · 不自动删除 · 原件保护沿用参考目录" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
  </WrapPanel>
  <StackPanel Grid.Row="2">
   <Border Background="#EEF4FB" CornerRadius="6" Padding="10,7" Margin="0,0,0,7"><TextBlock x:Name="Summary" Text="选择目录开始。相似媒体仅是整理候选，不代表内容完全相同。" TextWrapping="Wrap"/></Border>
   <WrapPanel Margin="0,0,0,8">
    <ComboBox x:Name="OriginBox" Width="135" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="所有来源"/><ComboBoxItem Content="截图"/><ComboBoxItem Content="下载图片"/><ComboBoxItem Content="Codex 生成"/><ComboBoxItem Content="其他"/></ComboBox>
    <ComboBox x:Name="KindBox" Width="125" Margin="8,0" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="所有媒体"/><ComboBoxItem Content="图片"/><ComboBoxItem Content="视频"/><ComboBoxItem Content="音乐 / 音频"/></ComboBox>
    <CheckBox x:Name="CandidatesBox" Content="仅相似组" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="4,0,12,0" VerticalAlignment="Center"/>
    <CheckBox x:Name="PrivacyBox" Content="含隐私字段" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,12,0" VerticalAlignment="Center"/>
    <CheckBox x:Name="ExifBox" Content="EXIF 同字段" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,12,0" VerticalAlignment="Center"/>
    <Button Content="原件保护设置" Style="{StaticResource MediaSecondaryButton}" Click="References_Click" Margin="0,0,8,0"/>
    <Button x:Name="WarningsButton" Content="读取提示" Style="{StaticResource MediaSecondaryButton}" Click="Warnings_Click"/>
    <Button Content="清空指纹缓存" Style="{StaticResource MediaSecondaryButton}" Click="ClearCache_Click" Margin="8,0,0,0"/>
   </WrapPanel>
  </StackPanel>
  <DataGrid x:Name="Results" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Results_SelectionChanged"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" CanUserAddRows="False">
   <DataGrid.ContextMenu><ContextMenu><MenuItem Header="打开所在位置" Click="OpenLocation_Click"/><MenuItem Header="复制路径" Click="CopyPath_Click"/></ContextMenu></DataGrid.ContextMenu>
   <DataGrid.Columns>
    <DataGridTextColumn Header="相似组" Binding="{Binding GroupText}" Width="80"/>
    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="170"/>
    <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="90"/>
    <DataGridTextColumn Header="来源" Binding="{Binding OriginText}" Width="85"/>
    <DataGridTextColumn Header="分辨率" Binding="{Binding Dimensions}" Width="120"/>
    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="85"/>
    <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="85"/>
    <DataGridTextColumn Header="指纹相似度" Binding="{Binding SimilarityText}" Width="90"/>
    <DataGridTextColumn Header="建议 / 保护" Binding="{Binding Advice}" Width="300"/>
    <DataGridTextColumn Header="拍摄时间（EXIF）" Binding="{Binding TakenText}" Width="160"/>
    <DataGridTextColumn Header="隐私检查" Binding="{Binding PrivacyText}" Width="200"/>
    <DataGridTextColumn Header="EXIF" Binding="{Binding MetadataText}" Width="220"/>
    <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="350"/>
   </DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="4" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Background="{StaticResource CardBrush}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#F3F4F6" CornerRadius="4" Margin="0,0,10,0"><Image x:Name="LeftImage" Stretch="Uniform"/></Border>
     <StackPanel Grid.Column="1"><TextBlock Text="当前文件" FontWeight="SemiBold"/><TextBlock x:Name="LeftDetails" Margin="0,8,0,0" TextWrapping="Wrap" Text="选中一个候选，显示并排图片对比。"/><TextBlock x:Name="LeftPath" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Background="{StaticResource CardBrush}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#F3F4F6" CornerRadius="4" Margin="0,0,10,0"><Image x:Name="RightImage" Stretch="Uniform"/></Border>
     <StackPanel Grid.Column="1"><TextBlock Text="同组对照 / 建议保留" FontWeight="SemiBold"/><TextBlock x:Name="RightDetails" Margin="0,8,0,0" TextWrapping="Wrap" Text="相似度是指纹评分，不是文件相同的概率。"/><TextBlock x:Name="RightPath" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
