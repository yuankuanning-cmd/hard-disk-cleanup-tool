<UserControl x:Class="ChatGPTCleanupTool.Controls.OverviewCenter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:ChatGPTCleanupTool.Controls" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Normal">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
  <StackPanel Margin="4,2,0,0">
   <Border CornerRadius="13" Padding="24,22" Margin="0,0,0,18">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6"><GradientStop Color="#424CC7" Offset="0"/><GradientStop Color="#7564DE" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="看清空间，让清理更有把握" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="磁盘容量、常用目录、清理入口，在这里一目了然。" Foreground="#DEDEFF" Margin="0,9,0,0" FontSize="13"/><TextBlock x:Name="UpdatedLabel" Text="只读取磁盘容量，不会自动开始全盘扫描或删除文件" Foreground="#C6C7FF" Margin="0,15,0,0" FontSize="11"/></StackPanel>
     <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新磁盘状态" Padding="15,8" VerticalAlignment="Top" Click="Refresh_Click"/>
    </Grid>
   </Border>
   <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="所列磁盘总容量" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="TotalValue" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="已使用空间" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="UsedValue" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="剩余可用空间" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="FreeValue" Text="—" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Grid.Column="3" Style="{StaticResource Card}" Background="{StaticResource WarningSoftBrush}"><StackPanel><TextBlock Text="快速清理扫描候选" Foreground="{StaticResource WarningBrush}" FontSize="11"/><TextBlock x:Name="CandidateValue" Text="未扫描" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,9,0,0" ToolTip="当前快速清理结果中未排除文件的合计，不代表全部可安全删除或实际可释放空间"/></StackPanel></Border>
   </Grid>
   <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="盘符容量合计 · 不代表文件分类或物理盘健康检测" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="本地磁盘" FontSize="17" FontWeight="SemiBold"/></DockPanel>
   <ListBox x:Name="DriveCards" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12" Padding="16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Grid.Column="1" Text="{Binding Format}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
      <StackPanel Grid.Row="1" Margin="0,13,0,10"><TextBlock Text="{Binding SpaceStatus}" Foreground="{Binding UsageBrush}" FontWeight="SemiBold"/><TextBlock Margin="0,7,0,0"><Run Text="可用 "/><Run Text="{Binding FreeText, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"><Run Text="总计 "/><Run Text="{Binding TotalText, Mode=OneWay}"/></TextBlock></StackPanel>
      <ui:DiskGauge Grid.Row="1" Grid.Column="1" Width="84" Height="84" UsedPercent="{Binding UsedPercent}" GaugeBrush="{Binding UsageBrush}" Margin="0,8,0,0" ToolTip="已使用空间比例"/>
      <Button Grid.Row="2" Grid.ColumnSpan="2" Content="分析此磁盘  →" Tag="{Binding Root}" Click="AnalyzeDrive_Click" Margin="0,6,0,0" ToolTip="仅以此盘为本次扫描根，不修改全局白名单；沿用原件和排除保护"/>
     </Grid>
    </Border>
   </DataTemplate></ListBox.ItemTemplate></ListBox>
   <TextBlock x:Name="DriveMessage" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <TextBlock Text="从你最需要的地方开始" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,11"/>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Style="{StaticResource ActionTile}" Margin="0,0,10,0" Tag="large" Click="Navigate_Click"><StackPanel><TextBlock Text="大文件与空间树  ↗" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="按目录、占用和文件大小找到空间大户" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap"/></StackPanel></Button>
    <Button Grid.Column="1" Style="{StaticResource ActionTile}" Margin="0,0,10,0" Tag="nps" Click="Navigate_Click"><StackPanel><TextBlock Text="NPS 完整工程  ↗" Foreground="{StaticResource SuccessBrush}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="识别整个工程，统一查看大小并回收" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap"/></StackPanel></Button>
    <Button Grid.Column="2" Style="{StaticResource ActionTile}" Tag="codex" Click="Navigate_Click"><StackPanel><TextBlock Text="Codex 与开发环境  ↗" Foreground="#A16AC7" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="结合任务、Git 状态核对生成产物" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap"/></StackPanel></Button>
   </Grid>
   <WrapPanel Margin="0,0,0,19"><Button Content="重复文件中心" Tag="duplicates" Click="Navigate_Click" Margin="0,0,8,6"/><Button Content="相似图片与媒体" Tag="media" Click="Navigate_Click" Margin="0,0,8,6"/><Button Content="软件占用与残留" Tag="software" Click="Navigate_Click" Margin="0,0,8,6"/><Button Content="快速清理候选" Tag="quick" Click="Navigate_Click" Margin="0,0,8,6"/><Button Content="1 GB 以上大文件视图" Tag="huge" Click="Navigate_Click" Margin="0,0,8,6"/></WrapPanel>
   <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
    <StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="＋ 收藏扫描目录" Click="AddFavorite_Click"/><StackPanel><TextBlock Text="常用目录" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="收藏只保存路径；点击分析时才扫描，不会自动清理。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel>
     <TextBlock x:Name="FavoritesHint" Text="把项目、下载或NPS工程集合目录收藏在这里，下次直接分析。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7" TextWrapping="Wrap"/>
     <ListBox x:Name="FavoriteItems" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><DockPanel><Button DockPanel.Dock="Right" Content="移除" Tag="{Binding Path}" Click="RemoveFavorite_Click" Padding="8,4" MinHeight="28"/><Button DockPanel.Dock="Right" Content="分析" Tag="{Binding Path}" Click="AnalyzeDrive_Click" Padding="12,4" MinHeight="28" Margin="0,0,7,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Medium"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,3,10,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
