<UserControl x:Class="ChatGPTCleanupTool.Controls.DuplicateCenter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MinHeight="220">
 <UserControl.Resources>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Padding" Value="10,6"/></Style>
 </UserControl.Resources>
 <TabControl>
  <TabItem Header="比较与选择">
   <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <WrapPanel>
      <TextBlock Text="保留策略" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <ComboBox x:Name="PolicyBox" Width="130" SelectedIndex="0" Margin="0,0,8,6">
       <ComboBoxItem Content="保留最新"/><ComboBoxItem Content="保留最旧"/><ComboBoxItem Content="路径最短"/><ComboBoxItem Content="分辨率最高"/><ComboBoxItem Content="质量最高（指标）"/>
      </ComboBox>
      <Button Style="{StaticResource SmallButton}" Content="应用到可见组" Click="ApplyPolicy_Click"/>
      <Button Style="{StaticResource SmallButton}" Content="取消全部选择" Click="ClearSelection_Click"/>
      <CheckBox x:Name="CrossBox" Content="仅跨目录" Margin="4,0,12,6" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
      <CheckBox x:Name="BackupBox" Content="仅备份/工作重叠" Margin="0,0,12,6" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
      <CheckBox x:Name="ReferenceBox" Content="仅匹配原件" Margin="0,0,8,6" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
     </WrapPanel>
     <WrapPanel>
      <ComboBox x:Name="DirectoryBox" IsEditable="True" DisplayMemberPath="Path" Width="350" MaxDropDownHeight="260" Margin="0,0,8,6" ToolTip="选择列表目录或输入上级目录路径；处理此目录及其子目录的可操作文件"/>
      <Button Style="{StaticResource SmallButton}" Content="按目录选择" Click="SelectDirectory_Click"/>
      <Button Style="{StaticResource SmallButton}" Content="按目录取消" Click="UnselectDirectory_Click"/>
      <TextBlock x:Name="ViewSummary" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
     </WrapPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" Foreground="{StaticResource MutedBrush}"
     Text="策略只生成选择计划，不直接删除。备份标记是按目录名称推断。完全相同图片的画质/分辨率相同；质量指标参考无损格式、像素数、位深，相同则保留最新。"/>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
     <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" SelectionChanged="FilesGrid_SelectionChanged" GridLinesVisibility="Horizontal" BorderThickness="0">
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding FullPath}"/></Style></DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选择" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding IsSelectable}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="组" Width="45" Binding="{Binding GroupNumber}" IsReadOnly="True"/>
       <DataGridTextColumn Header="角色 / 保护" Width="120" Binding="{Binding Role}" ElementStyle="{StaticResource StatusText}" IsReadOnly="True"/>
       <DataGridTextColumn Header="逻辑大小" Width="90" Binding="{Binding LogicalSize}" IsReadOnly="True"/>
       <DataGridTextColumn Header="实际占用" Width="90" Binding="{Binding AllocatedSize}" IsReadOnly="True"/>
       <DataGridTextColumn Header="修改时间" Width="132" Binding="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" IsReadOnly="True"/>
       <DataGridTextColumn Header="完整路径" Width="*" MinWidth="170" Binding="{Binding FullPath}" IsReadOnly="True"/>
       <DataGridTextColumn Header="图片指标" Width="130" Binding="{Binding ImageInformation}" IsReadOnly="True"/>
       <DataGridTextColumn Header="硬链接数" Width="80" Binding="{Binding LinkCount}" IsReadOnly="True"/>
      </DataGrid.Columns>
     </DataGrid>
     <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#EEF1F5"/>
     <Border Grid.Column="2" Padding="12" Background="#F6F8FC" CornerRadius="8">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top"><TextBlock FontWeight="SemiBold" Text="组内预览"/><TextBlock x:Name="PreviewLabel" Text="选中一行，比较同组副本" Margin="0,6,0,10" FontSize="11" TextWrapping="Wrap"/></StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PreviewList"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="White" Padding="10" Margin="0,0,0,10" CornerRadius="6"><StackPanel>
         <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="#697386" Margin="0,4,0,6"/>
         <Image Source="{Binding Thumbnail}" MaxHeight="140" Stretch="Uniform"/>
         <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" MaxHeight="140" TextTrimming="CharacterEllipsis"/>
        </StackPanel></Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
   </Grid>
  </TabItem>
  <TabItem Header="原件目录保护">
   <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock FontWeight="SemiBold" FontSize="15" Text="参考目录：只比较，永远不进入删除或替换队列"/>
     <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="参考目录会作为额外扫描范围，包含子目录；保护同步到快速清理、Codex 建议与空间回收页。重复中心也保护原件的硬链接别名，禁止原件作为硬链接来源。新增参考目录后请重新扫描以查找匹配。"/>
     <WrapPanel><Button Style="{StaticResource SmallButton}" Content="添加原件目录…" Click="AddReference_Click"/><Button Style="{StaticResource SmallButton}" Content="解除所选保护…" Click="RemoveReference_Click"/></WrapPanel>
     <TextBlock x:Name="ProtectionMessage" TextWrapping="Wrap" Margin="0,0,0,10"/>
    </StackPanel>
    <ListBox x:Name="ReferencesList"/>
   </DockPanel>
  </TabItem>
  <TabItem Header="操作记录 / 恢复">
   <DockPanel Margin="8">
    <WrapPanel DockPanel.Dock="Top"><Button Style="{StaticResource SmallButton}" Content="刷新记录" Click="RefreshRecords_Click"/><Button Style="{StaticResource SmallButton}" Content="导出所显示记录…" Click="ExportRecords_Click"/><TextBlock Text="最近 500 项；异常中断的准备记录也会保留。恢复路径存在时不要删除它。" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"/></WrapPanel>
    <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <DataGrid.Columns>
      <DataGridTextColumn Header="时间" Width="140" Binding="{Binding LocalTime, StringFormat={}{0:MM-dd HH:mm:ss}}"/>
      <DataGridTextColumn Header="操作" Width="125" Binding="{Binding Action}"/>
      <DataGridTextColumn Header="状态" Width="160" Binding="{Binding Status}"/>
      <DataGridTextColumn Header="理论" Width="85" Binding="{Binding TheoreticalSize}"/>
      <DataGridTextColumn Header="已释放" Width="85" Binding="{Binding ActualSize}"/>
      <DataGridTextColumn Header="原因 / 提示" Width="300" Binding="{Binding Reason}"/>
      <DataGridTextColumn Header="处理路径" Width="300" Binding="{Binding FilePath}"/>
      <DataGridTextColumn Header="保留副本" Width="300" Binding="{Binding KeeperPath}"/>
      <DataGridTextColumn Header="异常恢复路径" Width="300" Binding="{Binding BackupPath}"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </TabItem>
 </TabControl>
</UserControl>
