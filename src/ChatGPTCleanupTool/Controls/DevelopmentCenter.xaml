<UserControl x:Class="ChatGPTCleanupTool.Controls.DevelopmentCenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBrush}" FontFamily="Microsoft YaHei" FontSize="13" FontWeight="Normal">
    <UserControl.Resources>
        <Style x:Key="DevButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="开发环境清理中心" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,3,0,7" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="先核实归属与重建条件；未提交、未知、仍被引用的内容默认保留，所有结果默认不勾选。"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="项目目录" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="RootBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" ToolTip="项目目录或项目集合；下方全局白名单非空时以白名单为准"/>
                <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource DevButton}" Content="选择目录" Click="Browse_Click"/>
                <TextBlock Grid.Row="1" Text="Codex 目录" VerticalAlignment="Center" Margin="0,8,12,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CodexBox" Height="32" Margin="0,8,0,0" VerticalContentAlignment="Center"/>
                <Button Grid.Row="1" Grid.Column="2" Margin="8,8,0,0" Style="{StaticResource DevButton}" Content="分析环境" Click="Scan_Click"/>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="CodexCheck" Content="Codex 产物" IsChecked="True" Margin="0,0,18,0"/>
                    <CheckBox x:Name="CacheCheck" Content="包含用户级包缓存（超出项目白名单）" Margin="0,0,18,0"/>
                    <CheckBox x:Name="DockerCheck" Content="Docker 构建来源（只读）" Margin="0,0,18,0"/>
                    <CheckBox x:Name="CompareCheck" Content="比对跨工作树构建副本" IsChecked="True" Margin="0,0,18,0"/>
                    <TextBlock Text="合并目标" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="MergeBox" Width="130" Height="27" ToolTip="留空使用 origin/HEAD 或本地 main/master；不自动 fetch"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,8,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Summary" Text="尚未分析 · 项目目录可填写 D:\GitHub 等项目集合目录" FontWeight="SemiBold"/>
                <TextBlock x:Name="SelectionSummary" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="回收站操作可恢复；清空回收站前实际释放空间为 0。"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <ComboBox x:Name="FilterBox" Width="135" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0">
                    <ComboBoxItem Content="全部项目"/><ComboBoxItem Content="可重新生成"/><ComboBoxItem Content="未提交内容"/><ComboBoxItem Content="未知文件"/><ComboBoxItem Content="仍被引用 / 保护"/>
                </ComboBox>
                <Button Style="{StaticResource DevButton}" Content="选择可回收项" Click="SelectSafe_Click"/>
                <Button Style="{StaticResource DevButton}" Content="清空选择" Click="Clear_Click"/>
            </WrapPanel>
        </Grid>
        <TabControl Grid.Row="3">
            <TabItem Header="清理候选与保护依据">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                    <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              SelectionMode="Extended" SelectionChanged="Selection_Changed" Margin="0,8,0,6">
                        <DataGrid.ContextMenu>
                            <ContextMenu><MenuItem Header="打开所在位置" Click="Open_Click"/><MenuItem Header="加入清理排除" Click="Exclude_Click"/><MenuItem Header="重新分析环境" Click="Scan_Click"/></ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                            <DataGridTextColumn Header="分类" Binding="{Binding SafetyText}" ElementStyle="{StaticResource StatusText}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="190" IsReadOnly="True"/>
                            <DataGridTextColumn Header="逻辑大小" Binding="{Binding SizeText}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="实际占用" Binding="{Binding AllocatedText}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="75" IsReadOnly="True"/>
                            <DataGridTextColumn Header="最近修改" Binding="{Binding ModifiedText}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="操作条件" Binding="{Binding ActionText}" Width="190" IsReadOnly="True"/>
                            <DataGridTextColumn Header="项目" Binding="{Binding Project}" Width="260" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Git 状态" Binding="{Binding GitState}" Width="260" IsReadOnly="True"/>
                            <DataGridTextColumn Header="任务状态" Binding="{Binding TaskState}" Width="320" IsReadOnly="True"/>
                            <DataGridTextColumn Header="构建副本" Binding="{Binding DuplicateHint}" Width="240" IsReadOnly="True"/>
                            <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="350" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Padding="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="EvidenceText" TextWrapping="Wrap" Text="选择一项，查看任务归属、重建条件和保留原因。"/></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="检查提醒">
                <TextBox x:Name="WarningBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="12"/>
            </TabItem>
            <TabItem Header="操作记录">
                <DataGrid x:Name="RecordGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间（UTC）" Binding="{Binding TimeUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                        <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="220"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="100"/>
                        <DataGridTextColumn Header="原因 / 恢复说明" Binding="{Binding Reason}" Width="450"/>
                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <WrapPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Style="{StaticResource DevButton}" Content="模拟检查选择项" Click="DryRun_Click"/>
            <Button Style="{StaticResource DevButton}" Content="将选择项移入回收站" Click="Recycle_Click"/>
            <Button Style="{StaticResource DevButton}" Content="由 Git 移除选择的旧工作树" Click="Worktree_Click"/>
            <Button Style="{StaticResource DevButton}" Content="人工确认归档成果回收" Click="ManualArchive_Click"/>
            <Button Style="{StaticResource DevButton}" Content="打开位置" Click="Open_Click"/>
            <Button Style="{StaticResource DevButton}" Content="排除此项" Click="Exclude_Click"/>
            <Button Style="{StaticResource DevButton}" Content="刷新操作记录" Click="Records_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
