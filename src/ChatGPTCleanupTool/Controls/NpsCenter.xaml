<UserControl x:Class="ChatGPTCleanupTool.Controls.NpsCenter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource PageBrush}" FontFamily="Microsoft YaHei" FontSize="13" FontWeight="Normal">
 <UserControl.Resources>
  <Style x:Key="NpsButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
   <Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="NPS-EMT 工程清理" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="综合清单、目录结构与NPS配套内容识别工程 → 看整个工程大小 → 勾选整目录回收。孤立文件仅作线索。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8"/>
  </StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
   <StackPanel>
    <WrapPanel>
     <ComboBox x:Name="ScopeBox" SelectedIndex="0" Width="260" Margin="0,0,12,8">
      <ComboBoxItem Content="全盘：本地固定磁盘（忽略白名单）"/><ComboBoxItem Content="指定目录 / 下方扫描范围白名单"/>
     </ComboBox>
     <CheckBox x:Name="RemovableBox" Content="也扫描可移动盘（仅发现）" Margin="0,4,16,8"/>
     <Button Content="扫描工程并统计大小" Style="{StaticResource NpsButton}" Click="Scan_Click"/>
     <Button Content="打开上次结果" Style="{StaticResource NpsButton}" Click="Previous_Click"/>
    </WrapPanel>
    <DockPanel>
     <Button DockPanel.Dock="Right" Content="选择目录" Style="{StaticResource NpsButton}" Click="Browse_Click"/>
     <TextBox x:Name="RootBox" Height="30" VerticalContentAlignment="Center" ToolTip="指定目录模式下，优先使用下方非空白名单；多个目录可用分号分开"/>
    </DockPanel>
   </StackPanel>
  </Border>
  <TabControl Grid.Row="2" Margin="0,8,0,0">
   <TabItem Header="工程列表">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="4,6">
      <ComboBox x:Name="TypeBox" DockPanel.Dock="Right" Width="230" SelectedIndex="1" SelectionChanged="Type_Changed" Margin="10,0,0,0">
       <ComboBoxItem Content="全部工程、候选与线索"/><ComboBoxItem Content="完整工程（隐藏恢复快照和线索）"/><ComboBoxItem Content="仅备份工程"/><ComboBoxItem Content="仅工具恢复快照"/><ComboBoxItem Content="待归属模型线索（只读）"/><ComboBoxItem Content="待核实工程目录（只读）"/>
      </ComboBox>
      <TextBlock x:Name="Summary" Text="扫描后自动显示每个工程的空间大小，默认不勾选" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="所有跳过/未读取位置会列在扫描说明中"/>
     </DockPanel>
     <DataGrid x:Name="ProjectGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended"
      SelectionChanged="Project_Changed" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" RowHeight="36" FrozenColumnCount="2">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="删除" Width="54">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <CheckBox IsChecked="{Binding Cleanup.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Cleanup.CanRecycle}"
          HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4" ToolTip="{Binding CleanupStatus}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="完整工程" Binding="{Binding Name}" Width="210"/>
       <DataGridTextColumn Header="空间大小" Binding="{Binding SizeText}" SortMemberPath="LogicalBytes" Width="110"/>
       <DataGridTextColumn Header="实际占用" Binding="{Binding AllocatedText}" SortMemberPath="AllocatedBytes" Width="110"/>
       <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="70"/>
       <DataGridTextColumn Header="删除范围" Binding="{Binding DeleteScope}" Width="140"/>
       <DataGridTextColumn Header="状态 / 不可勾选原因" Binding="{Binding CleanupStatus}" Width="270">
        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}"/></DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="位置" Binding="{Binding FullPath}" Width="430"/>
       <DataGridTextColumn Header="识别类型" Binding="{Binding KindText}" Width="175"/>
       <DataGridTextColumn Header="综合识别依据" Binding="{Binding Evidence}" Width="450"/>
       <DataGridTextColumn Header="最近修改（UTC）" Binding="{Binding LastModifiedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="175"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" x:Name="SelectionText" Text="勾选左侧复选框即可；点击空间大小列可以排序" TextWrapping="Wrap" Margin="4,7" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
   </TabItem>
   <TabItem Header="扫描范围与跳过说明"><TextBox x:Name="Warnings" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="10"/></TabItem>
   <TabItem Header="工程回收记录">
    <DataGrid x:Name="RecordGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
     <DataGrid.Columns>
      <DataGridTextColumn Header="时间（UTC）" Binding="{Binding TimeUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
      <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="150"/>
      <DataGridTextColumn Header="工程位置" Binding="{Binding Path}" Width="400"/>
      <DataGridTextColumn Header="说明" Binding="{Binding Reason}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
  </TabControl>
  <WrapPanel Grid.Row="3" Margin="0,10,0,0">
   <Button Content="全选当前列表" Style="{StaticResource NpsButton}" Click="SelectAll_Click"/>
   <Button Content="取消全部勾选" Style="{StaticResource NpsButton}" Click="Clear_Click"/>
   <Button x:Name="DeleteButton" Content="回收勾选的整个工程" Style="{StaticResource DangerButton}" Padding="16,6" Margin="0,0,12,0" IsEnabled="False" Click="Recycle_Click"/>
   <Button Content="刷新回收记录" Style="{StaticResource NpsButton}" Click="Records_Click"/>
  </WrapPanel>
 </Grid>
</UserControl>
